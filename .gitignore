# SUMO source checkout and build output
/sumo/

# Python virtual environment
/.venv/

# Python caches
__pycache__/
*.pyc

# macOS
.DS_Store

# Learning study: full bid logs (several GB); the price summaries are kept
results/learning*/**/*_bids.csv.gz

# Simulation output and analysis caches (tens of GB; regenerated by the runners)
/results/

# Generated random trips (regenerated deterministically from the networks)
/simulation/params/
/simulation/params_noU/
/simulation/multiday/
/simulation/sweep/

# Generated figures, except the ones used in the write-up (Overleaf)
/analyze/figures/*
!/analyze/figures/update/
